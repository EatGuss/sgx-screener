# Copy to backend/.env and fill in. Never commit backend/.env.
#   cp backend/.env.example backend/.env

# --- Database (required) ---

# Owner/writer connection: migrations, nightly ingest, saved screens, accounts.
DATABASE_URL=postgresql://screener:screener@localhost:5432/sgx_screener

# Read-only connection used for every request-time screening query.
# Create the role with sql/create-readonly-role.sql. If unset, the writer URL is
# reused, but sessions are still opened with default_transaction_read_only=on.
READONLY_DATABASE_URL=postgresql://screener_ro:change-me@localhost:5432/sgx_screener

# --- API server ---

# Secret for signing session JWTs (required for accounts). Use >= 32 random bytes:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Browser origin allowed by CORS. The Vite dev server runs on 3001.
CLIENT_URL=http://localhost:3001

# API listen port. Optional — defaults to 3000.
PORT=3000

# --- Natural-language screening (OpenRouter or any OpenAI-compatible host) ---

# Required for /api/nl/* unless NL_PARSE_STUB=true.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Local demos only: with no API key, NL endpoints return canned responses.
# Never enable in production.
NL_PARSE_STUB=false

# --- Nightly ingest ---

# 5-field cron for the nightly Yahoo Finance ingest. Default 21:00 SGT, after the SGX close.
CRON_INGEST_SCHEDULE=0 21 * * *
CRON_INGEST_TIMEZONE=Asia/Singapore

# On boot, run ingest in the background if data lags the last completed SGX session.
INGEST_CATCHUP_ON_BOOT=true
